// codebase-size — classify a codebase by total LOC and generate hart reports.
// Uses sloc-guard for counting; ships as a single native machin binary.

type FileStat struct{path string language string total int code int comment int blank int}
type Report struct{top_files []FileStat}
type DirEntry struct{name string code int files int}
type HartResponse struct{ok bool url string}
type Config struct{repo string html string owner string artifact string json_out bool hart bool}
type Scale struct{name string lo int hi int score_lo int score_hi int meaning string}
type Summary struct{repo string class string score int bloat_grade string bloat_pct string total_files int total_lines int code_lines int comment_lines int blank_lines int avg_code int languages []DirEntry top_directories []DirEntry top_files []FileStat}

func usage() {
    println("codebase-size — classify a codebase by size and publish hart reports")
    println("")
    println("usage:")
    println("  codebase-size <repo> [--json]")
    println("  codebase-size <repo> --html report.html")
    println("  codebase-size <repo> --hart --owner <o> --artifact <a>")
    println("")
    println("flags:")
    println("  --json              print JSON summary to stdout")
    println("  --html <file>       write a self-contained HTML report")
    println("  --hart              publish the report to hart.intrane.fr")
    println("  --owner <name>      hart owner (required with --hart)")
    println("  --artifact <slug>   hart artifact slug (required with --hart)")
}

func parseArgs(a) (cfg) {
    cfg = Config{}
    cfg.repo = "."
    i := 1
    while i < len(a) {
        arg := a[i]
        if arg == "-h" || arg == "--help" {
            usage()
            exit(0)
        } else if arg == "--json" {
            cfg.json_out = true
        } else if arg == "--html" {
            if i + 1 < len(a) { cfg.html = a[i + 1] }
            i = i + 1
        } else if arg == "--hart" {
            cfg.hart = true
        } else if arg == "--owner" {
            if i + 1 < len(a) { cfg.owner = a[i + 1] }
            i = i + 1
        } else if arg == "--artifact" {
            if i + 1 < len(a) { cfg.artifact = a[i + 1] }
            i = i + 1
        } else if has_prefix(arg, "-") {
            println("unknown flag:", arg)
            exit(2)
        } else {
            cfg.repo = arg
        }
        i = i + 1
    }
    if cfg.hart && (len(cfg.owner) == 0 || len(cfg.artifact) == 0) {
        println("--hart requires --owner and --artifact")
        exit(2)
    }
    return cfg
}

func dirOf(path) (d) {
    parts := split(path, "/")
    if len(parts) > 6 {
        d = join(slice(parts, 5, 6), "/")
    } else {
        d = "(root)"
    }
    return d
}

func slice(xs, lo, hi) (out) {
    out = []string{}
    i := lo
    while i < hi {
        if i < len(xs) { out = append(out, xs[i]) }
        i = i + 1
    }
    return out
}

func scales() (s) {
    s = []Scale{}
    s = append(s, Scale{name:"Fragment", lo:0, hi:1000, score_lo:0, score_hi:10, meaning:"Fits in a single prompt"})
    s = append(s, Scale{name:"Snippet", lo:1000, hi:10000, score_lo:10, score_hi:25, meaning:"One person can rewrite it in a day"})
    s = append(s, Scale{name:"Module", lo:10000, hi:50000, score_lo:25, score_hi:45, meaning:"Small team, well-contained"})
    s = append(s, Scale{name:"Service", lo:50000, hi:100000, score_lo:45, score_hi:60, meaning:"Typical microservice territory"})
    s = append(s, Scale{name:"Platform", lo:100000, hi:250000, score_lo:60, score_hi:75, meaning:"Context must be chunked"})
    s = append(s, Scale{name:"Monolith", lo:250000, hi:500000, score_lo:75, score_hi:90, meaning:"No agent can load it all"})
    s = append(s, Scale{name:"Megasystem", lo:500000, hi:1000000, score_lo:90, score_hi:98, meaning:"Requires architectural decomposition"})
    s = append(s, Scale{name:"Galaxy", lo:1000000, hi:0, score_lo:98, score_hi:100, meaning:"Multiple products or decades of growth"})
    return s
}

func classify(totalCode, bloated, totalFiles) (name, score, bloatTenths) {
    if totalFiles == 0 { return "Empty", 0, 0 }
    raw := bloated * 10000 / totalFiles
    bloatTenths = (raw + 5) / 10
    sc := scales()
    base := 0
    name = ""
    i := 0
    while i < len(sc) {
        e := sc[i]
        if totalCode >= e.lo && (e.hi == 0 || totalCode < e.hi) {
            name = e.name
            rangeSize := e.hi - e.lo
            if rangeSize == 0 { rangeSize = totalCode - e.lo + 1 }
            scoreRange := e.score_hi - e.score_lo
            base = e.score_lo + (totalCode - e.lo) * scoreRange / rangeSize
            if base > 100 { base = 100 }
        }
        i = i + 1
    }
    if len(name) == 0 { name = "Galaxy"; base = 100 }
    penalty := bloated * 20 / totalFiles
    score = base + penalty
    if score > 100 { score = 100 }
    return name, score, bloatTenths
}

func bloatGrade(p) (grade) {
    if p < 2 { return "A" }
    if p < 5 { return "B" }
    if p < 10 { return "C" }
    if p < 20 { return "D" }
    return "F"
}

func nextClass(code) (name, target) {
    if code < 1000 { return "already minimal", 0 }
    if code < 10000 { return "Fragment", code - 1000 }
    if code < 50000 { return "Snippet", code - 10000 }
    if code < 100000 { return "Module", code - 50000 }
    if code < 250000 { return "Service", code - 100000 }
    if code < 500000 { return "Platform", code - 250000 }
    if code < 1000000 { return "Monolith", code - 500000 }
    return "Megasystem", code - 1000000
}

func sortEntries(entries) (sorted) {
    sorted = entries
    n := len(sorted)
    i := 0
    while i < n {
        j := 0
        while j < n - i - 1 {
            if sorted[j].code < sorted[j + 1].code {
                tmp := sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return sorted
}

func sortFiles(files) (sorted) {
    sorted = files
    n := len(sorted)
    i := 0
    while i < n {
        j := 0
        while j < n - i - 1 {
            if sorted[j].code < sorted[j + 1].code {
                tmp := sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return sorted
}

func topFiles(files, n) (out) {
    out = []FileStat{}
    i := 0
    while i < n && i < len(files) {
        out = append(out, files[i])
        i = i + 1
    }
    return out
}

func topEntries(entries, n) (out) {
    out = []DirEntry{}
    i := 0
    while i < n && i < len(entries) {
        out = append(out, entries[i])
        i = i + 1
    }
    return out
}

func scan(repo) (files, totalLines, codeLines, commentLines, blankLines, bloated, dirs, langEntries) {
    cmd := "sloc-guard stats files -f json " + repo + " --no-config -x node_modules -x .git -x coverage -x uploads -x data -x '*.db' -x 'in-memoria*'"
    c, out, err := exec(cmd)
    if c != 0 || len(err) > 0 {
        println("sloc-guard failed:", err)
        exit(1)
    }
    r := parse(out, Report{})
    files = r.top_files
    dirs = make(map[string]DirEntry)
    langs := make(map[string]DirEntry)
    i := 0
    while i < len(files) {
        f := files[i]
        totalLines = totalLines + f.total
        codeLines = codeLines + f.code
        commentLines = commentLines + f.comment
        blankLines = blankLines + f.blank
        if f.code > 500 { bloated = bloated + 1 }
        d := dirOf(f.path)
        de := dirs[d]
        de.name = d
        de.code = de.code + f.code
        de.files = de.files + 1
        dirs[d] = de
        le := langs[f.language]
        le.name = f.language
        le.code = le.code + f.code
        le.files = le.files + 1
        langs[f.language] = le
        i = i + 1
    }
    langEntries = mapToEntries(langs)
    return files, totalLines, codeLines, commentLines, blankLines, bloated, dirs, langEntries
}

func mapToEntries(m) (entries) {
    entries = []DirEntry{}
    ks := keys(m)
    i := 0
    while i < len(ks) {
        entries = append(entries, m[ks[i]])
        i = i + 1
    }
    return entries
}

func fmtPct(part, total) (s) {
    if total == 0 { s = "0.0"; return s }
    tenths := part * 1000 / total
    whole := tenths / 10
    frac := tenths % 10
    s = str(whole) + "." + str(frac)
    return s
}

func fmtBloat(tenths) (s) {
    whole := tenths / 10
    frac := tenths % 10
    s = str(whole) + "." + str(frac)
    return s
}

func formatLangRows(entries, totalCode) (s) {
    entries = sortEntries(entries)
    s = ""
    i := 0
    while i < len(entries) {
        e := entries[i]
        s = s + "<tr><td>" + e.name + "</td><td>" + str(e.files) + "</td><td>" + str(e.code) + "</td><td>" + fmtPct(e.code, totalCode) + "%</td></tr>\n"
        i = i + 1
    }
    return s
}

func formatDirRows(entries, totalCode) (s) {
    entries = sortEntries(entries)
    s = ""
    i := 0
    while i < len(entries) {
        e := entries[i]
        s = s + "<tr><td>" + e.name + "</td><td>" + str(e.files) + "</td><td>" + str(e.code) + "</td><td>" + fmtPct(e.code, totalCode) + "%</td></tr>\n"
        i = i + 1
    }
    return s
}

func formatFileRows(files) (s) {
    files = sortFiles(files)
    s = ""
    limit := 25
    if len(files) < limit { limit = len(files) }
    i := 0
    while i < limit {
        f := files[i]
        s = s + "<tr><td>" + str(i + 1) + "</td><td>" + f.path + "</td><td>" + str(f.code) + "</td><td>" + str(f.total) + "</td></tr>\n"
        i = i + 1
    }
    return s
}

func formatScaleRows(className) (s) {
    s = ""
    sc := scales()
    i := 0
    while i < len(sc) {
        e := sc[i]
        hi := "+"
        if e.hi > 0 { hi = "< " + str(e.hi) }
        row := "<tr><td>" + e.name + "</td><td>" + str(e.lo) + " - " + hi + "</td><td>" + str(e.score_lo) + " - " + str(e.score_hi) + "</td><td>" + e.meaning + "</td></tr>\n"
        if e.name == className {
            row = "<tr style='background:rgba(245,158,11,.12)'><td><strong>" + e.name + "</strong></td><td><strong>" + str(e.lo) + " - " + hi + "</strong></td><td><strong>" + str(e.score_lo) + " - " + str(e.score_hi) + "</strong></td><td><strong>" + e.meaning + "</strong></td></tr>\n"
        }
        s = s + row
        i = i + 1
    }
    return s
}

func buildReport(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) (html) {
    nextName, target := nextClass(codeLines)
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    html = report_template()
    html = replace(html, "{{REPO}}", cfg.repo)
    html = replace(html, "{{CLASS_NAME}}", className)
    html = replace(html, "{{MASS_SCORE}}", str(score))
    html = replace(html, "{{BLOAT_GRADE}}", grade)
    html = replace(html, "{{BLOAT_PCT}}", fmtBloat(bloatTenths))
    html = replace(html, "{{BLOATED_FILES}}", str(bloated))
    html = replace(html, "{{TOTAL_FILES}}", str(len(files)))
    html = replace(html, "{{TOTAL_LINES}}", str(totalLines))
    html = replace(html, "{{CODE_LINES}}", str(codeLines))
    html = replace(html, "{{COMMENT_LINES}}", str(commentLines))
    html = replace(html, "{{BLANK_LINES}}", str(blankLines))
    html = replace(html, "{{AVG_CODE}}", str(avgCode))
    html = replace(html, "{{CODE_PCT}}", fmtPct(codeLines, totalLines))
    html = replace(html, "{{COMMENT_PCT}}", fmtPct(commentLines, totalLines))
    html = replace(html, "{{BLANK_PCT}}", fmtPct(blankLines, totalLines))
    html = replace(html, "{{NEXT_CLASS}}", nextName)
    html = replace(html, "{{NEXT_TARGET}}", str(target))
    html = replace(html, "{{LANG_ROWS}}", formatLangRows(langEntries, codeLines))
    html = replace(html, "{{TOP_DIR_ROWS}}", formatDirRows(dirEntries, codeLines))
    html = replace(html, "{{TOP_FILE_ROWS}}", formatFileRows(files))
    html = replace(html, "{{SCALE_ROWS}}", formatScaleRows(className))
    return html
}

func publish(html, owner, artifact) (url) {
    u := "https://hart.intrane.fr/v1/publish?owner=" + owner + "&artifact=" + artifact + "&visibility=unlisted"
    status, body, err := http_request("POST", u, []string{"content-type: text/html"}, html)
    if status != 200 || len(err) > 0 {
        println("hart publish failed:", status, err, body)
        exit(1)
    }
    r := parse(body, HartResponse{})
    if r.ok == false || len(r.url) == 0 {
        println("hart publish returned no url:", body)
        exit(1)
    }
    url = r.url
    return url
}

func makeSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) (s) {
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    s = Summary{
        repo: cfg.repo,
        class: className,
        score: score,
        bloat_grade: grade,
        bloat_pct: fmtBloat(bloatTenths),
        total_files: len(files),
        total_lines: totalLines,
        code_lines: codeLines,
        comment_lines: commentLines,
        blank_lines: blankLines,
        avg_code: avgCode,
        languages: topEntries(langEntries, 10),
        top_directories: topEntries(dirEntries, 20),
        top_files: topFiles(files, 25)
    }
    return s
}

func printSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) {
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    nextName, target := nextClass(codeLines)
    println("repo:", cfg.repo)
    println("class:", className, "· mass score:", score, "/ 100")
    println("bloat grade:", grade, "(", bloated, "of", len(files), "files exceed 500 LOC =", fmtBloat(bloatTenths), "%)")
    println("files:", len(files), "total:", totalLines, "code:", codeLines, "comment:", commentLines, "blank:", blankLines, "avg:", avgCode)
    println("next class:", nextName, "· remove", target, "code lines")
    println("--- languages ---")
    i := 0
    while i < len(langEntries) && i < 10 {
        e := langEntries[i]
        println(e.name, e.code, "(" + fmtPct(e.code, codeLines) + "%)")
        i = i + 1
    }
    println("--- top directories ---")
    i = 0
    while i < len(dirEntries) && i < 10 {
        e := dirEntries[i]
        println(e.name, e.code, "(" + fmtPct(e.code, codeLines) + "%)")
        i = i + 1
    }
    println("--- top files ---")
    i = 0
    while i < len(files) && i < 10 {
        f := files[i]
        println(str(i + 1) + ".", f.path, f.code)
        i = i + 1
    }
}

func main() {
    a := args()
    if len(a) <= 1 {
        usage()
        exit(0)
    }
    cfg := parseArgs(a)
    files, totalLines, codeLines, commentLines, blankLines, bloated, dirs, langEntries := scan(cfg.repo)
    dirEntries := mapToEntries(dirs)
    className, score, bloatTenths := classify(codeLines, bloated, len(files))
    grade := bloatGrade(bloatTenths / 10)
    files = sortFiles(files)
    langEntries = sortEntries(langEntries)
    dirEntries = sortEntries(dirEntries)
    if cfg.json_out {
        s := makeSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries)
        println(json(s))
        return
    }
    if len(cfg.html) > 0 {
        html := buildReport(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries)
        write_file(cfg.html, html)
        println("wrote", cfg.html)
    }
    if cfg.hart {
        html := buildReport(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries)
        url := publish(html, cfg.owner, cfg.artifact)
        println("published:", url)
    }
    if !cfg.json_out && len(cfg.html) == 0 && !cfg.hart {
        printSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries)
    }
}
