func bloatGrade(p) (grade) {
    if p < 2 { return "A" }
    if p < 5 { return "B" }
    if p < 10 { return "C" }
    if p < 20 { return "D" }
    return "F"
}
func nextClass(code) (name, target) {
    if code < 1000 { return "already minimal", 0 }
    if code < 10000 { return "Fragment", code - 1000 }
    if code < 50000 { return "Snippet", code - 10000 }
    if code < 100000 { return "Module", code - 50000 }
    if code < 250000 { return "Service", code - 100000 }
    if code < 500000 { return "Platform", code - 250000 }
    if code < 1000000 { return "Monolith", code - 500000 }
    return "Megasystem", code - 1000000
}
func fmtPct(part, total) (s) {
    if total == 0 { s = "0.0"; return s }
    tenths := part * 1000 / total
    whole := tenths / 10
    frac := tenths % 10
    s = str(whole) + "." + str(frac)
    return s
}
func fmtBloat(tenths) (s) {
    whole := tenths / 10
    frac := tenths % 10
    s = str(whole) + "." + str(frac)
    return s
}
func topFiles(files, n) (out) {
    out = []FileStat{}
    i := 0
    while i < n && i < len(files) {
        out = append(out, files[i])
        i = i + 1
    }
    return out
}
func topEntries(entries, n) (out) {
    out = []DirEntry{}
    i := 0
    while i < n && i < len(entries) {
        out = append(out, entries[i])
        i = i + 1
    }
    return out
}
func formatLangRows(entries, totalCode) (s) {
    entries = sortEntries(entries)
    s = ""
    i := 0
    while i < len(entries) {
        e := entries[i]
        s = s + "<tr><td>" + e.name + "</td><td>" + str(e.files) + "</td><td>" + str(e.code) + "</td><td>" + fmtPct(e.code, totalCode) + "%</td></tr>\n"
        i = i + 1
    }
    return s
}
func formatDirRows(entries, totalCode) (s) {
    entries = sortEntries(entries)
    s = ""
    i := 0
    while i < len(entries) {
        e := entries[i]
        s = s + "<tr><td>" + e.name + "</td><td>" + str(e.files) + "</td><td>" + str(e.code) + "</td><td>" + fmtPct(e.code, totalCode) + "%</td></tr>\n"
        i = i + 1
    }
    return s
}
func formatFileRows(files) (s) {
    files = sortFiles(files)
    s = ""
    limit := 25
    if len(files) < limit { limit = len(files) }
    i := 0
    while i < limit {
        f := files[i]
        s = s + "<tr><td>" + str(i + 1) + "</td><td>" + f.path + "</td><td>" + str(f.code) + "</td><td>" + str(f.total) + "</td></tr>\n"
        i = i + 1
    }
    return s
}
func formatScaleRows(className) (s) {
    s = ""
    sc := scales()
    i := 0
    while i < len(sc) {
        e := sc[i]
        hi := "+"
        if e.hi > 0 { hi = "< " + str(e.hi) }
        row := "<tr><td>" + e.name + "</td><td>" + str(e.lo) + " - " + hi + "</td><td>" + str(e.score_lo) + " - " + str(e.score_hi) + "</td><td>" + e.meaning + "</td></tr>\n"
        if e.name == className {
            row = "<tr style='background:rgba(245,158,11,.12)'><td><strong>" + e.name + "</strong></td><td><strong>" + str(e.lo) + " - " + hi + "</strong></td><td><strong>" + str(e.score_lo) + " - " + str(e.score_hi) + "</strong></td><td><strong>" + e.meaning + "</strong></td></tr>\n"
        }
        s = s + row
        i = i + 1
    }
    return s
}
func buildReport(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) (html) {
    nextName, target := nextClass(codeLines)
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    html = report_template()
    html = replace(html, "{{REPO}}", cfg.repo)
    html = replace(html, "{{CLASS_NAME}}", className)
    html = replace(html, "{{MASS_SCORE}}", str(score))
    html = replace(html, "{{BLOAT_GRADE}}", grade)
    html = replace(html, "{{BLOAT_PCT}}", fmtBloat(bloatTenths))
    html = replace(html, "{{BLOATED_FILES}}", str(bloated))
    html = replace(html, "{{TOTAL_FILES}}", str(len(files)))
    html = replace(html, "{{TOTAL_LINES}}", str(totalLines))
    html = replace(html, "{{CODE_LINES}}", str(codeLines))
    html = replace(html, "{{COMMENT_LINES}}", str(commentLines))
    html = replace(html, "{{BLANK_LINES}}", str(blankLines))
    html = replace(html, "{{AVG_CODE}}", str(avgCode))
    html = replace(html, "{{CODE_PCT}}", fmtPct(codeLines, totalLines))
    html = replace(html, "{{COMMENT_PCT}}", fmtPct(commentLines, totalLines))
    html = replace(html, "{{BLANK_PCT}}", fmtPct(blankLines, totalLines))
    html = replace(html, "{{NEXT_CLASS}}", nextName)
    html = replace(html, "{{NEXT_TARGET}}", str(target))
    html = replace(html, "{{LANG_ROWS}}", formatLangRows(langEntries, codeLines))
    html = replace(html, "{{TOP_DIR_ROWS}}", formatDirRows(dirEntries, codeLines))
    html = replace(html, "{{TOP_FILE_ROWS}}", formatFileRows(files))
    html = replace(html, "{{SCALE_ROWS}}", formatScaleRows(className))
    return html
}
func makeSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) (s) {
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    fileDist := []int{0, 0, 0, 0, 0}
    i := 0
    while i < len(files) {
        c := files[i].code
        if c < 100 { fileDist[0] = fileDist[0] + 1 }
        else if c < 300 { fileDist[1] = fileDist[1] + 1 }
        else if c < 500 { fileDist[2] = fileDist[2] + 1 }
        else if c < 1000 { fileDist[3] = fileDist[3] + 1 }
        else { fileDist[4] = fileDist[4] + 1 }
        i = i + 1
    }
    s = Summary{
        repo: cfg.repo,
        class: className,
        score: score,
        bloat_grade: grade,
        bloat_pct: fmtBloat(bloatTenths),
        total_files: len(files),
        total_lines: totalLines,
        code_lines: codeLines,
        comment_lines: commentLines,
        blank_lines: blankLines,
        avg_code: avgCode,
        bloated_files: bloated,
        file_distribution: fileDist,
        languages: topEntries(langEntries, 10),
        top_directories: topEntries(dirEntries, 20),
        top_files: topFiles(files, 25)
    }
    return s
}
func printSummary(cfg, className, score, bloatTenths, grade, bloated, files, totalLines, codeLines, commentLines, blankLines, dirEntries, langEntries) {
    avgCode := 0
    if len(files) > 0 { avgCode = codeLines / len(files) }
    nextName, target := nextClass(codeLines)
    println("repo:", cfg.repo)
    println("class:", className, "· mass score:", score, "/ 100")
    println("bloat grade:", grade, "(", bloated, "of", len(files), "files exceed 500 LOC =", fmtBloat(bloatTenths), "%)")
    println("files:", len(files), "total:", totalLines, "code:", codeLines, "comment:", commentLines, "blank:", blankLines, "avg:", avgCode)
    println("next class:", nextName, "· remove", target, "code lines")
    println("--- languages ---")
    i := 0
    while i < len(langEntries) && i < 10 {
        e := langEntries[i]
        println(e.name, e.code, "(" + fmtPct(e.code, codeLines) + "%)")
        i = i + 1
    }
    println("--- top directories ---")
    i = 0
    while i < len(dirEntries) && i < 10 {
        e := dirEntries[i]
        println(e.name, e.code, "(" + fmtPct(e.code, codeLines) + "%)")
        i = i + 1
    }
    println("--- top files ---")
    i = 0
    while i < len(files) && i < 10 {
        f := files[i]
        println(str(i + 1) + ".", f.path, f.code)
        i = i + 1
    }
}
